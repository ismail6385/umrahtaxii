---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";

interface Props {
	title: string;
	description?: string;
	schema?: object;
}

const {
	title,
	description = "Premium Umrah Taxi Service in Saudi Arabia. Jeddah Airport to Makkah, Madinah transfers. Luxury vehicles, reliable service, 24/7 support.",
	schema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const baseSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "LocalBusiness",
			"@id": "https://umrahtaxi.site/#localbusiness",
			name: "Umrah Taxi Saudi Arabia",
			url: "https://umrahtaxi.site/",
			logo: "https://umrahtaxi.site/images/logo.png",
			image: "https://umrahtaxi.site/images/hero.png",
			description:
				"Premium Umrah Taxi service providing VIP private transfers from Jeddah Airport to Makkah, Madinah, and Ziyarat tours.",
			telephone: "+923080628195",
			priceRange: "$$$",
			address: {
				"@type": "PostalAddress",
				addressCountry: "SA",
				addressLocality: "Jeddah",
			},
			areaServed: [
				{
					"@type": "City",
					name: "Makkah",
				},
				{
					"@type": "City",
					name: "Jeddah",
				},
				{
					"@type": "City",
					name: "Madinah",
				},
			],
		},
		{
			"@type": "Service",
			"@id": "https://umrahtaxi.site/#service",
			serviceType: "Private VIP Airport Transfer",
			provider: {
				"@id": "https://umrahtaxi.site/#localbusiness",
			},
			areaServed: [
				{
					"@type": "City",
					name: "Makkah",
				},
				{
					"@type": "City",
					name: "Jeddah",
				},
				{
					"@type": "City",
					name: "Madinah",
				},
			],
		},
	],
};

// Automatically combine page-level schema into the master NLP entity graph
let finalSchema = baseSchema;
if (schema) {
	if (Array.isArray(schema)) {
		finalSchema["@graph"].push(...schema);
	} else {
		finalSchema["@graph"].push(schema as any);
	}
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>

		<title>{title} | Umrah Taxi Saudi Arabia</title>

		<link rel="canonical" href={canonicalURL.href} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL.href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta
			property="og:image"
			content="https://umrahtaxi.site/images/hero.png"
		/>

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta
			property="twitter:image"
			content="https://umrahtaxi.site/images/hero.png"
		/>

		{
			finalSchema && (
				<script
					type="application/ld+json"
					set:html={JSON.stringify(finalSchema)}
				/>
			)
		}
	</head>
	<body class="bg-black min-h-screen flex flex-col">
		<Header />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
		<FloatingWhatsApp />
	</body>
</html>

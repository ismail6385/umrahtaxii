    const whatsappBtn = document.getElementById("floating-whatsapp");

    if (whatsappBtn) {
        window.addEventListener("scroll", () => {
            // Show after scrolling down 300px (past hero usually)
            if (window.scrollY > 300) {
                whatsappBtn.classList.remove("translate-y-20", "opacity-0");
            } else {
                whatsappBtn.classList.add("translate-y-20", "opacity-0");
            }
        });
    }


